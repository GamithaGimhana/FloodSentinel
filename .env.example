# Optional backend environment variables (set in your shell or use uvicorn --env-file).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HTTP_TIMEOUT_SECONDS=12
WEATHER_CACHE_TTL_SECONDS=600
RADAR_CACHE_TTL_SECONDS=300
# MODEL_PATH and MODEL_METADATA_PATH default to repository-root artifacts.
# The frontend uses Vite's local proxy by default; production uses Nginx's same-origin proxy.

OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Persistent district history; defaults to runtime/assessments.sqlite3.
# HISTORY_DB_PATH=runtime/assessments.sqlite3
